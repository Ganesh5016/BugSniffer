# BugSniffer Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=8000
ENV=development

# Firebase (get from Firebase Console > Project Settings > Service Accounts)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# OR use JSON string:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Free API Keys (all have free tiers)
# VirusTotal: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=790c40ef8c42fe75c6174a2c8948acc14959b4ac95e73ef8885c3e628866c15a

# AbuseIPDB: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=689a8f48a6053d4a8ef8b0cd5b8526a6e74e936929ab09085d024af9a61768db307b1838accd4f86

# Google Safe Browsing: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=AIzaSyBvra5JufC6yqG523kzYCinRda2KxlNg34

# JWT Secret (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
